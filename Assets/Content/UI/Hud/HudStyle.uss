.hud-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: column;
}

.resources-panel {
    background-color: rgba(0, 0, 0, 0.8);
    padding: 10px;
    flex-direction: row;
    justify-content: flex-start;
}

.resource-label {
    color: white;
    font-size: 18px;
    margin-left: 20px;
    unity-font-style: bold;
}

.buildings-panel {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px;
    flex-direction: row;
    justify-content: center;
}

.building-button {
    width: 120px;
    height: 40px;
    margin: 0 10px;
    background-color: #2c3e50;
    color: white;
    border-radius: 5px;
}

.building-button:hover {
    background-color: #3498db;
}